@@ -27,6 +27,33 @@
     const build_config = b.addOptions();
     build_config.addOption([]const u8, "version", version);

+    // Optional embedder features, enabled by default. Apply modifications in
+    // order, e.g. -Dshell-features=-all,+history.
+    var history = true;
+    var printf_float = true;
+    const features = b.option(
+        []const u8,
+        "shell-features",
+        "Comma-separated +/- features: all, history, printf-float (default: all)",
+    ) orelse "";
+    var tokens = std.mem.tokenizeAny(u8, features, ", ");
+    while (tokens.next()) |token| {
+        const enabled = token[0] != '-';
+        const name = if (token[0] == '-' or token[0] == '+') token[1..] else token;
+        if (std.mem.eql(u8, name, "all")) {
+            history = enabled;
+            printf_float = enabled;
+        } else if (std.mem.eql(u8, name, "history")) {
+            history = enabled;
+        } else if (std.mem.eql(u8, name, "printf-float")) {
+            printf_float = enabled;
+        } else {
+            std.debug.panic("unknown shell feature: {s}; expected all, history, printf-float", .{name});
+        }
+    }
+    build_config.addOption(bool, "shell_history", history);
+    build_config.addOption(bool, "printf_float", printf_float);
+
     if (target.result.cpu.arch.isWasm()) {
         addWasmArtifact(b, target, optimize, build_config, lto);
         return;
